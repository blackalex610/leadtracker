 "lead_categories": [
  {
   "key": "BROKEN_SITE",
   "label": "Broken website",
   "label_bg": "Счупен сайт",
   "offer": "Website rescue",
   "offer_bg": "Спасяване на сайта",
   "description": "The website on the listing does not load, shows a parked domain or an 'under construction' page. Customers who click it from Google hit a dead end - urgent, easy to show, highest close rate.",
   "sellable": true
  },
  {
   "key": "NO_SITE",
   "label": "No website",
   "label_bg": "Няма сайт",
   "offer": "Starter website",
   "offer_bg": "Сайт визитка",
   "description": "Established on Google (reviews, phone) but no website at all. The biggest pool of buyers: customers who search for them can't see services, prices or photos and call a competitor instead.",
   "sellable": true
  },
  {
   "key": "SOCIAL_ONLY",
   "label": "Facebook/Instagram only",
   "label_bg": "Само Facebook/Instagram",
   "offer": "Own website",
   "offer_bg": "Собствен сайт",
   "description": "The Google listing links to a social page or link hub instead of a website. They already put effort into marketing - they get why it matters - but Google sends clicks to a page they don't control.",
   "sellable": true
  },
  {
   "key": "NEW_BUSINESS",
   "label": "New business",
   "label_bg": "Нов бизнес",
   "offer": "Launch package",
   "offer_bg": "Стартов пакет",
   "description": "Few reviews and no website: a business that is just starting. They are actively spending to get known, so a site plus a properly set-up Google profile is exactly what they need now.",
   "sellable": true
  },
  {
   "key": "PLATFORM_ONLY",
   "label": "Booking-platform page only",
   "label_bg": "Само профил в платформа",
   "offer": "Own site with direct booking",
   "offer_bg": "Собствен сайт с директни резервации",
   "description": "The listing points to a booking platform profile (Fresha, Booksy, Booking.com...). Every customer Google sends them pays the platform's commission or sees competitors next to them.",
   "sellable": true
  },
  {
   "key": "WEAK_SITE",
   "label": "Weak / outdated site",
   "label_bg": "Слаб / остарял сайт",
   "offer": "Website redesign",
   "offer_bg": "Нов сайт",
   "description": "Own website, but the audit found real problems: not mobile-friendly, outdated, slow, or no clear way to call/contact. They have paid for a site before, so the sale is an upgrade, not a convincing job.",
   "sellable": true
  },
  {
   "key": "NO_BOOKING",
   "label": "No online booking",
   "label_bg": "Без онлайн записване",
   "offer": "Online booking",
   "offer_bg": "Онлайн записване",
   "description": "A working site, but customers of this kind of business book appointments and there is no way to book online - every booking is a phone call during working hours.",
   "sellable": true
  },
  {
   "key": "WEAK_GOOGLE",
   "label": "Weak Google profile",
   "label_bg": "Слаб Google профил",
   "offer": "Google profile boost",
   "offer_bg": "Подобряване на Google профила",
   "description": "The website is fine, but the Google listing is thin: few reviews or photos, missing hours or details. Cheapest, fastest yes - a small first deal that opens the door for more.",
   "sellable": true
  },
  {
   "key": "UNCHECKED",
   "label": "Website not checked yet",
