# ---------------------------------------------------------------------------
# Lead Tracker configuration. Copy to `.env` (repo root) and adjust.
# Secrets live ONLY here / in your host's secret store — never in the browser
# or the database. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# development | test | production
ENVIRONMENT=development

# PostgreSQL (async driver). docker-compose overrides this for its containers.
DATABASE_URL=postgresql+asyncpg://leadtracker:leadtracker@localhost:5432/leadtracker
DATABASE_POOL_SIZE=10

# --- Business data provider: Google Places API (New) -------------------------
# Enable "Places API (New)" + billing in Google Cloud, create a key restricted to
# that API (and your server IP). Without a key, searches return
# "Provider not configured" — no fake data is ever generated.
PROVIDER_API_KEY=
PROVIDER_BASE_URL=https://places.googleapis.com/v1
PROVIDER_TIMEOUT_SECONDS=20
# enterprise            = phone, website, rating, reviews, hours in the Text Search call (recommended)
# enterprise_atmosphere = also the editorial description (more expensive SKU)
PLACES_FIELD_TIER=enterprise

# Synthetic demo data for UI testing without API credits. NEVER in production data.
DEMO_MODE=false

# Defaults for the runtime settings (editable later in Settings → General)
DEFAULT_COUNTRY=BG
DEFAULT_CITY=Sofia
DEFAULT_LANGUAGE=bg
TIMEZONE=Europe/Sofia

# --- Website auditing ----------------------------------------------------------
# milliseconds per request
WEBSITE_AUDIT_TIMEOUT=10000
MAX_CONCURRENT_AUDITS=5
AUDIT_USER_AGENT=LeadTrackerAudit/1.0 (+website-audit; respects robots.txt)
# Optional: real Lighthouse data via Google PageSpeed Insights (enable in Settings → Website audit)
PAGESPEED_API_KEY=

# --- Server --------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (only needed when the
# frontend is served from a different origin than /api).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Run background jobs inside the API process (simple deployments). Set false and
# run `python -m app.worker` separately for larger ones.
RUN_WORKER=true
WORKER_CONCURRENCY=2

# --- Authentication ---------------------------------------------------------------
# none  = no sign-in (local use, or behind an access proxy / VPN)
# token = per-user access tokens (python -m app.cli create-user ...)
AUTH_MODE=none
# Required (long random string) when AUTH_MODE=token:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# true behind HTTPS
SESSION_COOKIE_SECURE=false
# "none" only for cross-site frontends (requires SESSION_COOKIE_SECURE=true)
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE_HOURS=336

# --- Logging -------------------------------------------------------------------------
LOG_LEVEL=INFO
# JSON logs default to true in production
# LOG_JSON=true

# Google Maps Platform terms allow caching lat/lng for at most 30 days.
GOOGLE_LATLNG_RETENTION_DAYS=30

# --- Frontend (build time, apps/web) ----------------------------------------------
# Leave empty to call the API on the same origin via /api (recommended; use a
# reverse proxy or Vercel rewrite). Set to e.g. https://api.example.com otherwise.
VITE_API_BASE_URL=
